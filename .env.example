# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- 微交易 API 配置 (microtransaction-api) ----
# STEAM_WEB_API_KEY: Steam Web API Key，从 https://partner.steamgames.com 获取
# 生成路径：Menu → User & Permissions → Manage Groups → 选择应用 → Generate WebAPI Key
STEAM_WEB_API_KEY=""

# STEAM_APP_ID: 你的 Steam 应用 ID
STEAM_APP_ID="480"

# STEAM_SANDBOX: 设为 "true" 使用沙盒环境（开发/测试，不扣真实资金）
STEAM_SANDBOX="true"

# STEAM_MOCK_MODE: 设为 "true" 可在无 Steam Key 时使用模拟模式（本地开发）
# 注意：上线前必须设为 "false" 并配置真实 STEAM_WEB_API_KEY
STEAM_MOCK_MODE="true"
