# 陪伴私语 AI 大模型配置（OpenAI 兼容接口，默认 DeepSeek）
# 复制本文件为 .env 并填入真实 API Key 即可启用真实 AI 对话。
# 未配置 VITE_AI_API_KEY 时，游戏自动降级为本地离线回复（不崩溃）。

VITE_AI_API_BASE=https://api.deepseek.com/v1
VITE_AI_API_KEY=
VITE_AI_MODEL=deepseek-chat
VITE_AI_MAX_TOKENS=500
VITE_AI_TEMPERATURE=0.9

# Steam 微交易配置（上线收款必填，详见 docs/steam/release-checklists/microtransaction-setup.md）
STEAM_WEB_API_KEY=
STEAM_APP_ID=480
STEAM_SANDBOX=false
STEAM_MOCK_MODE=false
